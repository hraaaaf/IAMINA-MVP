# ── IAmina backend .dockerignore ─────────────────────────────────────────────
# Keep the image lean — exclude dev artefacts, secrets, and local state.

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Local database
*.sqlite3
*.db

# Test artefacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.log

# Secrets — never bake into image
.env
*.env
firebase-credentials.json
service-account*.json

# Editor / OS junk
.DS_Store
.idea/
.vscode/
*.swp
*~

# Static files (generated at runtime via collectstatic)
staticfiles/

# Git
.git/
.gitignore
