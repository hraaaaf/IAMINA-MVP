# ── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# App runtime mode. The shared Vercel deployment used for dev/test keeps this
# as development even when Vercel itself targets its Production environment.
# Set to production only for a real production release; that enables SMTP/password-recovery gates.
IAMINA_ENV=development

# Production/Vercel example (project: iamina-certified):
# DEBUG=False
# ALLOWED_HOSTS=iamina-certified.vercel.app
# CORS_ALLOWED_ORIGINS=https://iamina-review.vercel.app
# CSRF_TRUSTED_ORIGINS=https://iamina-review.vercel.app
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
# Dev: leave empty → SQLite
# Prod: postgres://user:pass@host:5432/dbname
# Vercel backend: PostgreSQL is mandatory; SQLite is rejected.
DATABASE_URL=

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Firebase Auth ─────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS=/path/to/firebase-credentials.json

# ── LLM — active provider ─────────────────────────────────────────────────────
# Options: groq (default) | kimi | claude | fallback
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Gemini (multimodal Vision/STT only; not the text Companion default) ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Kimi (OpenAI-compatible) ──────────────────────────────────────────────────
# Set LLM_PROVIDER=kimi to activate.
# KIMI_BASE_URL: your self-hosted or provider endpoint (e.g. https://api.moonshot.cn/v1)
# KIMI_API_KEY:  your API key
KIMI_BASE_URL=
KIMI_API_KEY=

# ── Claude (standby) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Default False — enable only for internal tooling, never in patient-facing prod
ENABLE_DJANGO_ADMIN=False

# ── Demo (Flutter String.fromEnvironment) ─────────────────────────────────────
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# ── Medical safety flags ──────────────────────────────────────────────────────
# Keep false unless a supervised medical pilot has been explicitly approved.
MEDICAL_PILOT_MODE=false

# Keep false for medical answers unless streaming output is safety-filtered before emission.
LLM_MEDICAL_STREAMING=false

# Must remain false. IAmina must not recommend insulin dose changes.
ALLOW_INSULIN_ADVICE=false

# Protected narration provider shadow. Both switches default OFF.
# SHADOW enables the protected path. INTERNAL_LIVE additionally permits real
# provider transport for active staff only, with locale/script/random opaque
# body token as the complete provider payload. Patient-facing output remains
# deterministic and Groq patient-data processor governance remains separate.
NARRATION_PROTECTED_PROVIDER_SHADOW=false
NARRATION_PROTECTED_PROVIDER_INTERNAL_LIVE=false
# Comma-separated Django user IDs explicitly opted into internal live.
NARRATION_PROTECTED_PROVIDER_INTERNAL_LIVE_STAFF_IDS=

# Groq bounded provider candidate. Required only when internal live is enabled.
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=

# Must remain false. IAmina must not provide definitive diagnosis.
ALLOW_DIAGNOSIS=false
