# ========================================
# LLM Provider (Gemini active, Kimi standby)
# ========================================
# Active provider — Gemini 2.5 Flash
GEMINI_API_KEY=

# Standby — Kimi 2.5 (Moonshot AI). Uncomment when ready to activate.
# MOONSHOT_API_KEY=sk-...
# USE_KIMI=False  # Set to True to switch to Kimi (requires MOONSHOT_API_KEY)

# ========================================
# Paid external AI FinOps guard
# ========================================
# External paid AI fails closed unless BOTH values are provided at runtime.
# Keep secrets/prices/budgets out of git. The JSON must include controlled
# pricing, global/provider/workload budgets, retry/circuit policy, call limits,
# and the per-user throttle window/ceiling.
AI_FINOPS_HMAC_KEY=
AI_FINOPS_RUNTIME_CONFIG_JSON=

# ========================================
# Firebase Admin SDK
# ========================================
# CRITICAL: Place firebase-credentials.json OUTSIDE this repo
# Example paths:
#   Windows: C:/Users/YOUR_NAME/.amina-secrets/firebase-credentials.json
#   Mac/Linux: /home/YOUR_NAME/.amina-secrets/firebase-credentials.json
FIREBASE_CREDENTIALS_PATH=

# ========================================
# Django Backend
# ========================================
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Django Admin — set to False in production to remove /admin/ attack surface
ENABLE_DJANGO_ADMIN=True

# Database
# Dev (SQLite — default, no setup needed):
DATABASE_URL=sqlite:///db.sqlite3
# Dev (PostgreSQL via Docker — run: docker-compose up -d db):
# DATABASE_URL=postgres://amina:amina_dev@localhost:5432/amina_db
# Prod (set in platform dashboard, never commit):
# DATABASE_URL=postgres://user:password@host:5432/amina_db

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ========================================
# Flutter Frontend (optional — for build-time env injection)
# ========================================
# API_BASE_URL=http://localhost:8000/api/v1

# ========================================
# Demo credentials (Flutter build-time only — never commit real values)
# ========================================
# DEMO_EMAIL=
# DEMO_PASSWORD=

# ========================================
# Medical safety flags
# ========================================
# Keep false unless a supervised medical pilot has been explicitly approved.
MEDICAL_PILOT_MODE=false

# Keep false for medical answers unless streaming output is safety-filtered before emission.
LLM_MEDICAL_STREAMING=false

# Must remain false. IAmina must not recommend insulin dose changes.
ALLOW_INSULIN_ADVICE=false

# Must remain false. IAmina must not provide definitive diagnosis.
ALLOW_DIAGNOSIS=false
