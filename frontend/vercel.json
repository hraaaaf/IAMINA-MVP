{
  "buildCommand": "bash vercel_build.sh",
  "outputDirectory": "build/web",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/preview-proxy?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
