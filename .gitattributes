# Normalize all text to LF in the repo and on checkout. The app builds and runs
# in Linux containers / on Linux servers, so CRLF (Windows core.autocrlf) would
# break shell scripts and container processes. Windows editors handle LF fine.
* text=auto eol=lf

# Files executed inside the Linux container or by a shell — must be LF.
*.sh       text eol=lf
*.py       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
Dockerfile text eol=lf

# Windows-only helper — keep CRLF so it runs natively in PowerShell.
*.ps1      text eol=crlf

# Binary assets — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff  binary
*.woff2 binary
